{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jra-bashira-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  // ログもトレースも全件残す。invocation はレースの段階ごと。
  // issues はダッシュボードの問題検出（Workers Issues）。
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
    "issues": { "enabled": true }
  },
  // 金曜・土曜 16:45 JST。Cloudflare の cron は UTC で、曜日の 1 は日曜なので FRI,SAT。
  // scheduled は翌日の全レースを積むだけ。予想は Queue が 3 並列で進める。
  // previews には triggers を置かない。プレビューの scheduled は動かない。
  "triggers": {
    "crons": ["45 7 * * FRI,SAT"]
  },
  "vars": {
    "BASHIRA_MCP_URL": "https://mcp.bashira.omninode.co.jp/mcp",
    "BABA_URL": "https://jra-dify-pipeline.hdsk.workers.dev/baba/latest",
    "NOTION_DATABASE_ID": "3c57c7b2e419808ba999e9c1909fa39c",
    "STATS_PERIOD_YEARS": "5",
    "STATS_MIN_STARTS": "30",
    "STATS_BROODMARE_SIRE_MIN_STARTS": "50",
    "COURSE_SUMMARY_MIN_COUNT": "30",
    "DEFAULT_MODEL": "gemini-flash-latest",
    "ACCESS_TEAM_DOMAIN": "https://hdsk.cloudflareaccess.com",
    "ACCESS_CLIENT_ID_GROK": "",
    "ACCESS_CLIENT_ID_MUSE": ""
  },
  // id を書かない。最初の wrangler deploy が KV を作る（Wrangler 4.45 以降）。
  "kv_namespaces": [
    { "binding": "APP_KV" }
  ],
  // queue は名前だけで、id は無い。同じ deploy が未作成なら Queue を作る。
  "queues": {
    "producers": [
      { "binding": "RACE_QUEUE", "queue": "jra-bashira-race" }
    ],
    "consumers": [
      {
        "queue": "jra-bashira-race",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        // src/types.ts の QUEUE_MAX_RETRIES と同じ数にする。
        "max_retries": 3,
        // 失敗をすぐ再配送すると、同じジョブキーの KV 書き込みが 1 秒制限に当たる。
        "retry_delay": 30,
        // 再試行を使い切ったメッセージは捨てず、ここに残す。
        // このキューは deploy では作られない。先に次を実行する:
        // npx wrangler queues create jra-bashira-race-dlq
        "dead_letter_queue": "jra-bashira-race-dlq",
        // 同時に 3 メッセージ。別レースは並走する。同じレースの次段階は、前のメッセージが終わってから積む。
        "max_concurrency": 3
      }
    ]
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Workers Builds は wrangler の custom build を実行しない。
  // ダッシュボードのビルドコマンドでも同じスクリプトを走らせる（README）。
  "build": {
    "command": "node scripts/write-build-info.mjs"
  },
  "durable_objects": {
    "bindings": [{ "name": "BASHIRA_AUTH", "class_name": "BashiraAuth" }]
  },
  // 最初の deploy で SQLite 版 Durable Object を作る。exports とは併用しない。
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BashiraAuth"] }
  ],
  // 同じアカウントの workers.dev へ global fetch すると届かず 404 になる。
  // 馬場は jra-dify-pipeline のサービスバインディングで取る。
  "services": [
    { "binding": "BABA", "service": "jra-dify-pipeline" }
  ],
  // プレビューは本番の設定を継承しない。このブロックが無いと
  // Workers Builds の `npx wrangler preview` が失敗する。
  // https://developers.cloudflare.com/workers/previews/configuration/
  // KV と Queue は置かない。同じ id や jra-bashira-race を指すと本番に書く。
  // consumer、cron、ルートは置かない。プレビューの scheduled は動かない。
  // Notion のトークンは Secret なのでここには無く、プレビューには入らない。
  "previews": {
    "vars": {
      "BASHIRA_MCP_URL": "https://mcp.bashira.omninode.co.jp/mcp",
      "BABA_URL": "https://jra-dify-pipeline.hdsk.workers.dev/baba/latest",
      // 本番のデータベース ID は置かない。トークンが後から入っても本番には書かない。
      "NOTION_DATABASE_ID": "",
      "STATS_PERIOD_YEARS": "5",
      "STATS_MIN_STARTS": "30",
      "STATS_BROODMARE_SIRE_MIN_STARTS": "50",
      "COURSE_SUMMARY_MIN_COUNT": "30",
      "DEFAULT_MODEL": "gemini-flash-latest",
      "ACCESS_TEAM_DOMAIN": "https://hdsk.cloudflareaccess.com",
      "ACCESS_CLIENT_ID_GROK": "",
      "ACCESS_CLIENT_ID_MUSE": ""
    },
    // クラスと migrations はトップレベルのまま。プレビューごとに別の名前空間になる。
    "durable_objects": {
      "bindings": [{ "name": "BASHIRA_AUTH", "class_name": "BashiraAuth" }]
    },
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
    // 馬場の取得だけ、相手 Worker の本番を呼ぶ。この Worker の KV や Notion には書かない。
    "services": [
      { "binding": "BABA", "service": "jra-dify-pipeline" }
    ]
  }
}
